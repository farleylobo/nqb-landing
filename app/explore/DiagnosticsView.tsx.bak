"use client";

import { useMemo, useState } from "react";
import { computeDiagnostics } from "@/lib/enrichment/diagnostics";
import { scoreColor, THEME_COLORS } from "@/lib/enrichment/labels";
import type { WorkspaceSettings } from "@/lib/enrichment/taxonomy";
import type { ViewId } from "@/lib/enrichment/views";
import type { EntityFilters } from "@/lib/filterEntities";
import type { Entity } from "@/lib/types";
import type { ViewMode } from "./ExploreShell";

interface Props {
  entities: Entity[];
  settings: WorkspaceSettings;
  onDrilldown: (next: { view?: ViewId; filters?: EntityFilters; mode?: ViewMode }) => void;
  onSelectEntity: (id: string) => void;
}

const fmt = (n: number) => n.toLocaleString("pt-BR");
const pct = (part: number, total: number) => (total > 0 ? `${Math.round((part / total) * 100)}%` : "—");

/** "Diagnóstico de rede": light theme with narrative arc (Situação → Fricção → Estrutura → Decisão → Confiança) */
export default function DiagnosticsView({ entities, settings, onDrilldown, onSelectEntity }: Props) {
  const d = useMemo(() => computeDiagnostics(entities, settings), [entities, settings]);
  const t = d.totals;
  const [activeSectionId, setActiveSectionId] = useState<string>("visao-geral");
  const [selectedPerson, setSelectedPerson] = useState<Entity | null>(null);

  if (t.people === 0) {
    return (
      <div className="flex h-full flex-col items-center justify-center gap-2 text-gray-500">
        <div>Ainda não há pessoas neste workspace.</div>
        <div className="text-xs text-gray-400">Use &quot;Importar rede&quot; para trazer um export do LinkedIn ou uma planilha.</div>
      </div>
    );
  }

  const maxTheme = Math.max(1, ...d.themes.map((x) => x.people));
  const maxCohort = Math.max(1, ...d.cohorts.map((c) => c.people));

  const handleSelectPerson = (id: string) => {
    const person = entities.find(e => e.id === id);
    if (person) setSelectedPerson(person);
    onSelectEntity(id);
  };

  const sections = [
    { id: "visao-geral", label: "📊 Visão Geral", icon: "📊" },
    { id: "lacunas", label: "⚠️ Lacunas", icon: "⚠️" },
    { id: "hubs", label: "🏢 Hubs Estratégicos", icon: "🏢" },
    { id: "timeline", label: "📈 Timeline", icon: "📈" },
    { id: "top-15", label: "👥 Top Prioridades", icon: "👥" },
    { id: "funcoes", label: "🔧 Funções", icon: "🔧" },
    { id: "temas", label: "🎯 Temas de Missão", icon: "🎯" },
  ];

  return (
    <div className="flex h-full bg-gray-50">
      {/* SIDEBAR */}
      <aside className="w-64 border-r border-gray-200 bg-gray-100 p-6 overflow-y-auto fixed left-0 top-0 h-full">
        <div className="mb-6">
          <h3 className="text-xs font-bold uppercase tracking-wide text-gray-600 mb-4">Diagnóstico da Rede</h3>
          <div className="border-t border-gray-200" />
        </div>
        
        <nav className="space-y-1">
          {sections.map(section => (
            <button
              key={section.id}
              onClick={() => {
                setActiveSectionId(section.id);
                const el = document.getElementById(section.id);
                if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
              }}
              className={`w-full text-left px-3 py-2 rounded-md text-sm transition ${
                activeSectionId === section.id
                  ? "border-l-4 border-gray-600 bg-white text-gray-900 font-semibold"
                  : "text-gray-700 hover:bg-white hover:text-gray-600"
              }`}
            >
              {section.label}
            </button>
          ))}
        </nav>
      </aside>

      {/* MAIN CONTENT */}
      <main className="ml-64 flex-1 overflow-y-auto">
        <div className="mx-auto max-w-4xl p-12">
          {/* PREAMBLE */}
          <div className="mb-12 rounded-lg border-l-4 border-gray-600 bg-white p-5 text-sm text-gray-700">
            <strong>Sua rede, estruturada em 5 eixos:</strong> poder de decisão, função, tema, organização, relação. Cada número é clicável. Comece pela Visão Geral, explore as Lacunas para saber onde focar.
          </div>

          {/* SECTION: VISÃO GERAL (SITUAÇÃO) */}
          <section id="visao-geral" className="mb-16 scroll-mt-24">
            <h2 className="mb-4 text-2xl font-bold text-gray-900">Sua Rede em Números</h2>
            
            {/* Main KPI */}
            <div className="mb-8 rounded-lg border-l-4 border-gray-600 bg-white p-8 shadow-sm">
              <div className="text-xs font-bold uppercase tracking-wide text-gray-600">Total de Pessoas</div>
              <div className="mt-3 text-5xl font-bold text-gray-600">{fmt(t.people)}</div>
              <div className="mt-3 text-sm text-gray-600">
                em {fmt(t.organizations)} organizações · {fmt(t.withCoreTheme)} com tema central · {fmt(t.decisionMakers)} decisores
              </div>
            </div>

            {/* Secondary KPIs Grid */}
            <div className="grid grid-cols-4 gap-4">
              <Kpi label="Prioritários" value={fmt(t.priorities)} note="Score 60+" onClick={() => onDrilldown({ view: "prioridades" })} />
              <Kpi label="Núcleo de Missão" value={fmt(t.withCoreTheme)} note={pct(t.withCoreTheme, t.people)} onClick={() => onDrilldown({ view: "nucleo-missao" })} />
              <Kpi label="Decisores" value={fmt(t.decisionMakers)} note="C-level / Board" onClick={() => onDrilldown({ view: "toda", filters: { seniority: ["c-level", "diretor", "conselho"] } })} />
              <Kpi label="Vozes Públicas" value={fmt(t.publicVoices)} note="Influência digital" onClick={() => onDrilldown({ view: "amplificadores" })} />
            </div>
          </section>

          {/* SECTION: LACUNAS (FRICÇÃO) */}
          <section id="lacunas" className="mb-16 scroll-mt-24">
            <h2 className="mb-2 text-2xl font-bold text-gray-900">Onde Você Está Fraco</h2>
            <p className="mb-6 text-sm text-gray-600">Estes temas centrais têm menos presença na sua rede. São os caminhos mais difíceis de ativar.</p>
            
            <div className="grid grid-cols-3 gap-4">
              {d.gaps.map(gap => (
                <button
                  key={gap.theme}
                  onClick={() => onDrilldown({ view: "toda", filters: { themes: [gap.theme] } })}
                  className="rounded-lg border-l-4 border-gray-500 bg-white p-5 text-left shadow-sm transition hover:shadow-md"
                >
                  <div className="font-semibold text-gray-900">● {gap.label}</div>
                  <div className="mt-2 text-sm text-gray-600">{fmt(gap.people)} pessoas · {fmt(gap.decisionMakers)} decisores</div>
                </button>
              ))}
            </div>
          </section>

          {/* SECTION: HUBS (ESTRUTURA) */}
          <section id="hubs" className="mb-16 scroll-mt-24">
            <h2 className="mb-2 text-2xl font-bold text-gray-900">Onde Está a Massa Crítica</h2>
            <p className="mb-6 text-sm text-gray-600">Organizações com {settings.hubMinContacts}+ contatos. Use como ponte para novas conversas.</p>
            
            <div className="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
              <table className="w-full text-sm">
                <thead className="border-b border-gray-200 bg-gray-50">
                  <tr>
                    <th className="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-600">Organização</th>
                    <th className="px-6 py-3 text-right text-xs font-semibold uppercase text-gray-600">Pessoas</th>
                    <th className="px-6 py-3 text-right text-xs font-semibold uppercase text-gray-600">Decisores</th>
                    <th className="px-6 py-3 text-right text-xs font-semibold uppercase text-gray-600">Tema Central</th>
                    <th className="px-6 py-3 text-xs font-semibold uppercase text-gray-600">Funções</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-gray-200">
                  {d.hubs.map(hub => (
                    <tr key={hub.companyKey} onClick={() => onDrilldown({ view: "toda", filters: { companyKeys: [hub.companyKey] } })} className="cursor-pointer transition hover:bg-gray-50">
                      <td className="px-6 py-3 font-medium text-gray-900">{hub.name}</td>
                      <td className="px-6 py-3 text-right tabular-nums text-gray-700">{hub.people}</td>
                      <td className="px-6 py-3 text-right tabular-nums text-gray-700">{hub.decisionMakers}</td>
                      <td className="px-6 py-3 text-right tabular-nums text-gray-700">{hub.coreThemePeople}</td>
                      <td className="px-6 py-3 truncate text-gray-600">{hub.topFunction ?? "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              {d.hubs.length === 0 && <div className="px-6 py-8 text-center text-sm text-gray-500">Nenhuma organização com {settings.hubMinContacts}+ contatos.</div>}
            </div>
          </section>

          {/* SECTION: TIMELINE (CONTEXTO) */}
          <section id="timeline" className="mb-16 scroll-mt-24">
            <h2 className="mb-2 text-2xl font-bold text-gray-900">Como Sua Rede Foi Construída</h2>
            <p className="mb-6 text-sm text-gray-600">Pessoas por ano de conexão. Onde houve investimento? Onde há recência?</p>
            
            <div className="space-y-3">
              {d.cohorts.map(c => (
                <button
                  key={c.year}
                  onClick={() => onDrilldown({ view: "toda", filters: { yearFrom: c.year, yearTo: c.year } })}
                  className="flex w-full items-center gap-4 rounded-lg bg-white px-4 py-3 text-sm transition hover:bg-gray-50"
                >
                  <span className="w-12 text-right font-medium text-gray-900 tabular-nums">{c.year}</span>
                  <div className="flex-1 overflow-hidden rounded-full bg-gray-200">
                    <div className="h-2 bg-gray-600" style={{ width: `${(c.people / maxCohort) * 100}%` }} />
                  </div>
                  <span className="w-16 text-right tabular-nums text-gray-700">{fmt(c.people)}</span>
                  <span className="w-40 truncate text-gray-600">{c.topCompany ?? ""}</span>
                </button>
              ))}
            </div>
          </section>

          {/* SECTION: TOP PRIORIDADES (DECISÃO) */}
          <section id="top-15" className="mb-16 scroll-mt-24">
            <h2 className="mb-2 text-2xl font-bold text-gray-900">Próximas Conversas que Fazem Sentido</h2>
            <p className="mb-6 text-sm text-gray-600">Top 15 por relevância. Clique em uma pessoa para ver o porquê do score.</p>
            
            <div className="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
              {d.topPriorities.map(p => (
                <button
                  key={p.id}
                  onClick={() => handleSelectPerson(p.id)}
                  className="flex w-full items-center gap-3 border-b border-gray-200 px-6 py-3 last:border-b-0 transition hover:bg-gray-50"
                >
                  <span
                    className="flex h-9 w-9 items-center justify-center rounded text-xs font-bold text-white tabular-nums"
                    style={{ backgroundColor: scoreColor(p.score) }}
                  >
                    {p.score}
                  </span>
                  <span className="min-w-0 flex-1 truncate font-medium text-gray-900">{p.name}</span>
                  <span className="max-w-xs truncate text-sm text-gray-600">{p.company ?? p.role ?? ""}</span>
                </button>
              ))}
            </div>
          </section>

          {/* SECTION: FUNÇÕES */}
          <section id="funcoes" className="mb-16 scroll-mt-24">
            <h2 className="mb-2 text-2xl font-bold text-gray-900">Distribuição de Funções</h2>
            <p className="mb-6 text-sm text-gray-600">O que as pessoas fazem na rede?</p>
            
            <div className="flex flex-wrap gap-2">
              {d.functions.slice(0, 18).map(f => (
                <button
                  key={f.id}
                  onClick={() => onDrilldown({ view: "toda", filters: { functions: [f.id] } })}
                  className="rounded-full border border-gray-400 bg-white px-3 py-1.5 text-sm text-gray-900 transition hover:border-gray-600 hover:bg-gray-50"
                >
                  {f.label} <span className="text-gray-600">({fmt(f.people)})</span>
                </button>
              ))}
            </div>
          </section>

          {/* SECTION: TEMAS (TEMAS) */}
          <section id="temas" className="mb-16 scroll-mt-24">
            <h2 className="mb-2 text-2xl font-bold text-gray-900">Temas de Missão</h2>
            <p className="mb-6 text-sm text-gray-600">● = tema central (seu foco) | ○ = tema adjacente</p>
            
            <div className="space-y-3">
              {d.themes.map(theme => (
                <button
                  key={theme.theme}
                  onClick={() => onDrilldown({ view: "toda", filters: { themes: [theme.theme] } })}
                  className="w-full rounded-lg bg-white p-4 text-left shadow-sm transition hover:shadow-md"
                >
                  <div className="mb-2 flex justify-between">
                    <div className={`font-semibold ${theme.kind === "core" ? "text-gray-900" : "text-gray-700"}`}>
                      {theme.kind === "core" ? "●" : "○"} {theme.label}
                    </div>
                  </div>
                  <div className="mb-3 flex justify-between text-xs text-gray-600">
                    <span>{fmt(theme.people)} pessoas · {fmt(theme.decisionMakers)} decisores · {fmt(theme.publicVoices)} vozes públicas</span>
                  </div>
                  <div className="overflow-hidden rounded-full bg-gray-200">
                    <div className="h-2 rounded-full" style={{ width: `${(theme.people / maxTheme) * 100}%`, backgroundColor: THEME_COLORS[theme.theme] ?? "#999" }} />
                  </div>
                </button>
              ))}
            </div>
          </section>

          {/* METHODOLOGY (CONFIANÇA) */}
          <section id="metodologia" className="mb-12 scroll-mt-24 border-t border-gray-200 pt-12">
            <h2 className="mb-2 text-2xl font-bold text-gray-900">Como Funciona o Score</h2>
            <p className="mb-6 text-sm text-gray-700">
              Merlin ranqueia pessoas em 5 eixos: <strong>(1) Poder de decisão</strong> — seniority e conselho, <strong>(2) Função</strong> — expertise relevante para seu objetivo, <strong>(3) Tema</strong> — alinhamento com sua missão, <strong>(4) Organização</strong> — importância estratégica, <strong>(5) Relação</strong> — se está mapeada, vale mais. Score final: média ponderada + transparência: você vê cada eixo. Sem inferência. Sem black box.
            </p>
            
            <div className="rounded-lg border-l-4 border-gray-600 bg-white p-5">
              <div className="font-semibold text-gray-900">Seus dados são seus</div>
              <p className="mt-2 text-sm text-gray-700">Sem scraping. Sem retenção além de 30 dias. Importados por ação humana.</p>
            </div>
          </section>

          <div className="h-24" />
        </div>
      </main>

      {/* SIDE PANEL */}
      {selectedPerson && (
        <aside className="w-96 border-l border-gray-200 bg-white p-6 overflow-y-auto fixed right-0 top-0 h-full shadow-lg">
          <button onClick={() => setSelectedPerson(null)} className="absolute top-6 right-6 text-gray-400 hover:text-gray-600">✕</button>
          
          <div className="mb-6">
            <div className="mb-4 h-20 w-20 rounded-full bg-gradient-to-br from-gray-500 to-gray-600" />
            <h3 className="text-lg font-bold text-gray-900">{selectedPerson.name}</h3>
            <p className="text-sm text-gray-600">{selectedPerson.role} @ {selectedPerson.company}</p>
          </div>

          <div className="border-t border-gray-200 pt-6 space-y-6">
            <div>
              <div className="text-xs font-bold uppercase tracking-wide text-gray-600 mb-2">Score</div>
              <div className="text-sm text-gray-900"><strong>{selectedPerson.score ?? "—"}</strong> — Poder · Função · Tema · Org · Relação</div>
            </div>

            <div>
              <div className="text-xs font-bold uppercase tracking-wide text-gray-600 mb-2">Temas</div>
              <div className="text-sm text-gray-700">● Tema central · ○ Adjacente</div>
            </div>

            <div>
              <div className="text-xs font-bold uppercase tracking-wide text-gray-600 mb-2">Funções</div>
              <div className="text-sm text-gray-700">{selectedPerson.role ?? "—"}</div>
            </div>

            <div>
              <div className="text-xs font-bold uppercase tracking-wide text-gray-600 mb-2">Decisor?</div>
              <div className="text-sm text-gray-700">Sim / Não</div>
            </div>

            <div>
              <div className="text-xs font-bold uppercase tracking-wide text-gray-600 mb-2">Conectado desde</div>
              <div className="text-sm text-gray-700">2021</div>
            </div>
          </div>
        </aside>
      )}
    </div>
  );
}

function Kpi({ label, value, note, onClick }: { label: string; value: string; note?: string; onClick?: () => void }) {
  const content = (
    <>
      <div className="text-xs font-bold uppercase tracking-wide text-gray-600">{label}</div>
      <div className="mt-2 text-2xl font-bold tabular-nums text-gray-900">{value}</div>
      {note && <div className="mt-1 text-xs text-gray-600">{note}</div>}
    </>
  );
  return onClick ? (
    <button onClick={onClick} className="rounded-lg border border-gray-200 bg-white p-4 text-left shadow-sm transition hover:border-gray-400 hover:shadow-md">
      {content}
    </button>
  ) : (
    <div className="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">{content}</div>
  );
}
